        {
          "name": "Sincronizar usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-KEY",
                "value": "{{apiKey}}"
              },
              {
                "key": "X-Usuario",
                "value": "{{correo}}"
              },
              {
                "key": "X-Rol",
                "value": "{{rol}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{host}}:8081/api/usuarios/sincronizar",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ana Perez\",\n  \"correo\": \"ana@duocuc.cl\",\n  \"telefono\": \"+56912345678\"\n}"
            }
          }
        },
        {
