{
  "info": {
    "name": "PanolApp - 4 microservicios",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "host",
      "value": "http://localhost"
    },
    {
      "key": "apiKey",
      "value": "cambia-esta-clave-por-una-propia"
    },
    {
      "key": "correo",
      "value": "admin@panol.cl"
    },
    {
      "key": "rol",
